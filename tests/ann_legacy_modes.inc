void Legacy_ANN_ConstQ_Predict(float angle, float V, float *L, float *R)
{
    float x0;
    float x1;
    float a1[ANN_H1_SIZE];
    float a2[ANN_H2_SIZE];
    float y0;
    float y1;
    float sum;
    unsigned int i;
    unsigned int j;


    /*
     * 1. MATLAB input normalization
     * x = (input - (-1))*1 -1 = input
     */
    x0 = (angle - ANN_IN_ANGLE_Q_XMIN) * ANN_IN_ANGLE_Q_GAIN - 1.0f;
    x1 = (V - ANN_IN_V_XMIN) * ANN_IN_V_GAIN - 1.0f;


    /* Layer 1 */
    for(i=0;i<ANN_H1_SIZE;i++)
    {
        sum = ANN_B1_Q[i]
            + ANN_W1_Q[i][0]*x0
            + ANN_W1_Q[i][1]*x1;

        a1[i] = ann_tansig(sum);
    }

    /* Layer 2 */
    for(i=0;i<ANN_H2_SIZE;i++)
    {
        sum = ANN_B2_Q[i];

        for(j=0;j<ANN_H1_SIZE;j++)
        {
            sum += ANN_W2_Q[i][j]*a1[j];
        }

        a2[i] = ann_tansig(sum);
    }

    /* Output layer */
    y0 = ANN_B3_Q[0];
    y1 = ANN_B3_Q[1];

    for(j=0;j<ANN_H2_SIZE;j++)
    {
        y0 += ANN_W3_Q[0][j]*a2[j];
        y1 += ANN_W3_Q[1][j]*a2[j];
    }

    /*
     * MATLAB output mapminmax is identity.
     * y0/y1 are directly L and R estimation results.
     */
    if (L != 0)
        {
            *L = (y0 + 1.0f) * ANN_OUT_L_SCALE + ANN_OUT_L_XMIN;
        }

        if (R != 0)
        {
            *R = (y1 + 1.0f) * ANN_OUT_R_SCALE + ANN_OUT_R_XMIN;
        }
}
void Legacy_ANN_Droop_Predict(float angle, float V, float *L, float *R)
{
    float x0;
    float x1;
    float a1[ANN_H1_SIZE];
    float a2[ANN_H2_SIZE];
    float y0;
    float y1;
    float sum;
    unsigned int i;
    unsigned int j;

    x0 = (angle - ANN_IN_ANGLE_droop_XMIN) * ANN_IN_ANGLE_droop_GAIN - 1.0f;
    x1 = (V - ANN_IN_V_droop_XMIN) * ANN_IN_droop_GAIN - 1.0f;



    /*
     * ==============================
     * Layer 1
     * 2 -> 30
     * tansig
     * ==============================
     */

    for(i=0U;i<ANN_H1_SIZE;i++)
    {

        sum = ANN_DROOP_B1[i]
            + ANN_DROOP_W1[i][0]*x0
            + ANN_DROOP_W1[i][1]*x1;


        a1[i] = ann_tansig(sum);

    }



    /*
     * ==============================
     * Layer 2
     * 30 -> 20
     * tansig
     * ==============================
     */

    for(i=0U;i<ANN_H2_SIZE;i++)
    {

        sum = ANN_DROOP_B2[i];


        for(j=0U;j<ANN_H1_SIZE;j++)
        {
            sum += ANN_DROOP_W2[i][j]*a1[j];
        }


        a2[i]=ann_tansig(sum);

    }



    /*
     * ==============================
     * Output layer
     * 20 -> 2
     * purelin
     *
     * MATLAB:
     * a3=b3+LW3_2*a2
     *
     * ==============================
     */

    y0 = ANN_DROOP_B3[0];
    y1 = ANN_DROOP_B3[1];


    for(j=0U;j<ANN_H2_SIZE;j++)
    {

        y0 += ANN_DROOP_W3[0][j]*a2[j];

        y1 += ANN_DROOP_W3[1][j]*a2[j];

    }



    /*
     * ==============================
     * Output reverse normalization
     *
     * MATLAB:
     * identity
     *
     * ==============================
     */


    if (L != 0)
            {
                *L = (y0 + 1.0f) * ANN_OUT_L_SCALE + ANN_OUT_L_XMIN;
            }

            if (R != 0)
            {
                *R = (y1 + 1.0f) * ANN_OUT_R_SCALE + ANN_OUT_R_XMIN;
            }

}
